# Example Environment Configuration
# Copy this file to .env and add your actual secret API keys

GROQ_API=your_groq_api_key_here

# Optional: override the model. Defaults to qwen/qwen3.8-27b (fast, TTS-friendly).
# Run `python -c "import os;from dotenv import load_dotenv;from openai import OpenAI;load_dotenv();print([m.id for m in OpenAI(base_url='https://api.groq.com/openai/v1',api_key=os.getenv('GROQ_API')).models.list().data])"`
# to list the models your key can actually reach.
GROQ_MODEL=qwen/qwen3.8-27b

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_AUTOGEN=your_nvidia_autogen_key_here
DEEPGRAM_KEY=your_deepgram_key_here
